{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionFront",
  "description": "The front matter of a decision record.",
  "type": "object",
  "properties": {
    "date": {
      "description": "`YYYY-MM-DD`.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "kind": {
      "description": "Decision or answer.",
      "$ref": "#/$defs/DecisionKind"
    }
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "date"
  ],
  "$defs": {
    "DecisionKind": {
      "description": "What a decision record is.",
      "oneOf": [
        {
          "description": "A decision of the owner.",
          "type": "string",
          "const": "decision"
        },
        {
          "description": "An answer recorded for a question.",
          "type": "string",
          "const": "answer"
        }
      ]
    }
  }
}
